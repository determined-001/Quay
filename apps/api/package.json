{
  "name": "@checkout/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --sourcemap --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --external:hono --external:@hono/node-server --external:drizzle-orm --external:@libsql/client --external:zod --external:@stellar/stellar-sdk",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@checkout/core": "workspace:*",
    "@checkout/offramp": "workspace:*",
    "@checkout/soroban": "workspace:*",
    "@checkout/stellar": "workspace:*",
    "@hono/node-server": "2.1.0",
    "@libsql/client": "0.17.4",
    "@stellar/stellar-sdk": "16.2.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.0",
    "pino": "^10.3.1",
    "redis": "^6.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "tsx": "4.23.9",
    "vitest": "4.1.10"
  }
}
